# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
opencode.json

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# originales 3D pesados (exports de Meshy). La version optimizada vive en
# public/models/avatares/web y es lo unico que se sirve.
/assets-3d/avatares/_inbox/
/assets-3d/avatares/**/*.glb
/public/models/avatares/_inbox/
