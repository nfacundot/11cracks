generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LessonType {
  LESSON
  QUIZ
  GAME
  PREGUNTADOS
  CONTRARRELOJ
}

enum OptionMode {
  TEXT
  IMAGE
  BOTH
}

enum GameMode {
  ANAGRAM
  INFOGRAMA
}

enum GameCategory {
  OIDO
  GOL
  LETRAS
  ALIMENTACION
}

enum IndicatorCategory {
  DEPORTE
  NEUROCRACKS
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCH
  ORDER
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  STREAK
  XP
  LESSON
  GAME
  TEAM
  SYSTEM
}

enum Role {
  JUGADOR
  ENTRENADOR
  ADMIN
  SUPERADMIN
}

enum TeamRole {
  PLAYER
  CAPTAIN
  COACH
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  username     String   @unique
  avatarUrl    String?
  avatarConfig Json?
  bio          String?
  position     String?
  favoriteTeam String?
  country      String?
  role         Role     @default(JUGADOR)

  xp           Int      @default(0)
  coins        Int      @default(0)
  trophies     Int      @default(0)
  currentStreak Int     @default(0)
  bestStreak   Int      @default(0)
  lastActiveAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMembers      TeamMember[]
  lessonsCompleted LessonProgress[]
  answers          AnswerRecord[]
  gameSessions     GameSession[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  streakDays       StreakDay[]
  indicators       Indicator[]

  @@index([xp])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  logoUrl     String?
  totalXp     Int      @default(0)
  tactics     Json?
  createdAt   DateTime @default(now())

  members    TeamMember[]
  alignments Alignment[]

  @@index([totalXp])
}

model Alignment {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  formation String   @default("4-3-3")
  positions Json     @default("{}")
  trazos    Json     @default("[]")
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, order])
}

model TeamMember {
  id             String   @id @default(cuid())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           TeamRole @default(PLAYER)
  joinedAt       DateTime @default(now())
  lineupPosition String?

  @@unique([teamId, userId])
}

model StreakDay {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  @@unique([userId, date])
}

model Clase {
  id          String   @id @default(cuid())
  name        String
  description String?
  emoji       String   @default("🗺️")
  color       String   @default("#16a34a")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  temas Tema[] @relation("EtapaMaterias")

  etapaTemas   EtapaTema[]
  etapaLessons EtapaLesson[]

  @@index([order])
}

model Tema {
  id       String  @id @default(cuid())
  name     String
  emoji    String  @default("⭐")
  color    String  @default("#16a34a")
  order    Int     @default(0)
  xpReward Int     @default(0)
  posX     Float   @default(50)
  posY     Float   @default(50)

  clases     Clase[]     @relation("EtapaMaterias")
  lessons    Lesson[]
  etapaTemas EtapaTema[]

  @@index([order])
}

model EtapaTema {
  id      String @id @default(cuid())
  claseId String
  temaId  String
  posX    Float  @default(50)
  posY    Float  @default(50)
  clase   Clase  @relation(fields: [claseId], references: [id], onDelete: Cascade)
  tema    Tema   @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@unique([claseId, temaId])
  @@index([temaId])
}

model EtapaLesson {
  id       String @id @default(cuid())
  claseId  String
  lessonId String
  posX     Float  @default(50)
  posY     Float  @default(50)
  clase    Clase  @relation(fields: [claseId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([claseId, lessonId])
  @@index([lessonId])
}

model Lesson {
  id        String     @id @default(cuid())
  temaId    String?
  tema      Tema?      @relation(fields: [temaId], references: [id], onDelete: SetNull)
  title     String
  description String?
  emoji       String     @default("⚽")
  color       String     @default("#16a34a")
  type        LessonType @default(LESSON)
  gameMode    GameMode?
  optionMode  OptionMode  @default(TEXT)
  timeSeconds Int?
  order       Int        @default(0)
  xpReward    Int        @default(10)
  posX        Float      @default(50)
  posY        Float      @default(50)
  createdAt   DateTime   @default(now())

  gameId    String? @unique
  game      Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  questions Question[]
  progress  LessonProgress[]
  etapaLessons EtapaLesson[]

  @@index([type, order])
  @@index([temaId, order])
}

model Question {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MULTIPLE_CHOICE)
  prompt      String
  imageUrl    String?
  explanation String?
  order       Int          @default(0)
  timeSeconds Int?

  options QuestionOption[]
  answers AnswerRecord[]

  @@index([lessonId, order])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  imageUrl   String?
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(NOT_STARTED)
  bestScore   Int            @default(0)
  attempts    Int            @default(0)
  completed   Boolean        @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model AnswerRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String?
  isCorrect  Boolean
  answeredAt DateTime @default(now())

  @@index([userId])
}

model GameSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType  String
  score     Int
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, gameType])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  icon      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Indicator {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  category   IndicatorCategory @default(DEPORTE)
  percentage Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([category])
}

model Characteristic {
  id         String   @id @default(cuid())
  name       String
  percentage Int      @default(0)
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Game {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  category          GameCategory
  emoji             String       @default("🎮")
  color             String       @default("#22c55e")
  description       String?
  active            Boolean      @default(true)
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  oidoWords         OidoCrackWord[]
  golWords          GolPalabraWord[]
  letrasWords       LetrasCrackWord[]
  alimentacionWords AlimentacionWord[]
  lesson            Lesson?

  @@index([category, active, order])
  @@index([order])
}

model OidoCrackWord {
  id       String  @id @default(cuid())
  gameId   String?
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  word     String
  label    String?
  language String  @default("en")
  active   Boolean @default(true)
  order    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options OidoCrackOption[]

  @@index([active, order])
  @@index([gameId])
}

model OidoCrackOption {
  id       String   @id @default(cuid())
  wordId   String
  word     OidoCrackWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  label    String
  imageUrl String
  isCorrect Boolean @default(false)
  order    Int      @default(0)

  @@index([wordId])
}

model GolPalabraWord {
  id       String  @id @default(cuid())
  gameId   String?
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  word     String
  meaning  String
  language String  @default("en")
  active   Boolean @default(true)
  order    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options GolPalabraOption[]

  @@index([active, order])
  @@index([gameId])
}

model GolPalabraOption {
  id       String   @id @default(cuid())
  wordId   String
  word     GolPalabraWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  label    String
  isCorrect Boolean @default(false)
  order    Int      @default(0)

  @@index([wordId])
}

model LetrasCrackWord {
  id       String   @id @default(cuid())
  gameId   String?
  game     Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  word     String
  meaning  String
  imageUrl String
  language String   @default("en")
  active   Boolean  @default(true)
  order    Int      @default(0)
  letters  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([gameId])
}

model AlimentacionWord {
  id        String   @id @default(cuid())
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String
  audioUrl  String?
  useTts    Boolean  @default(true)
  ttsVoice  String   @default("female")
  isHealthy Boolean
  language  String   @default("es")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([gameId])
}
